# Sao chép thành client/.env khi chạy local hoặc client/.env.production khi build production.
# Đường dẫn mount frontend: / nếu ở domain root, hoặc /travel/ nếu deploy dưới path con.
VITE_BASE_PATH=/

# Để trống để dùng <base path>api cùng origin; nếu API ở domain khác, điền URL đầy đủ.
VITE_API_BASE_URL=

# Chỉ dùng cho proxy Vite khi phát triển; bản production không dùng giá trị này.
VITE_API_PROXY_TARGET=http://localhost:3000