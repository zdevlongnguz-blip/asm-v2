# Sao chép file này thành server/.env. Điền key Gemini thật trực tiếp trong server/.env.
PORT=3000
# Bắt buộc để dùng trợ lý AI; không chia sẻ hoặc commit key thật.
GEMINI_API_KEY=
# Tùy chọn; nếu bỏ trống, server dùng gemini-3-flash-preview.
GEMINI_MODEL=gemini-3-flash-preview
# Dành cho chức năng News API nếu sau này triển khai (hiện chưa hoàn thiện).
NEWS_API_KEY=
# Thay bằng thông tin liên hệ của bạn để tuân thủ chính sách Nominatim.
NOMINATIM_UA=my-asm-app (email-cua-ban@gmail.com)
# Mặc định chỉ cho phép frontend local này đọc response khác origin.
# Khi frontend và API tách origin trên production, thay bằng origin frontend; nhiều origin cách nhau bằng dấu phẩy.
CLIENT_ORIGINS=http://localhost:5173
